pragma language_version >= 0.16 && <= 0.18;

import CompactStandardLibrary;

export struct Signature {
  r: CurvePoint,
  s: Field
}

// public state
export ledger signers: Vector<3, CurvePoint>;
export ledger stateRoot: Bytes<32>;

constructor(newSigners: Vector<3, CurvePoint>, initialStateRoot: Bytes<32>) {
  signers = disclose(newSigners);
  stateRoot = disclose(initialStateRoot);
}

export circuit verifySignature(
  pk: CurvePoint,
  msg: Bytes<32>,
  sig: Signature
): Boolean {
  const challengeInput = [sig.r, pk, degradeToTransient(msg)];
  const e = transientHash<[CurvePoint, CurvePoint, Field]>(challengeInput);
  const lhs = ecMulGenerator(sig.s);
  const eTimesPk = ecMul(pk, e);
  const rhs = ecAdd(sig.r, eTimesPk);
  return lhs == rhs;
}

export circuit updateStateRoot(newRoot: Bytes<32>, signature: Signature): [] {
  // Check if the signature is valid for any of the authorized signers
  const sig = disclose(signature);
  const root = disclose(newRoot);
  const valid = 
    verifySignature(signers[0], root, sig) ||
    verifySignature(signers[1], root, sig) ||
    verifySignature(signers[2], root, sig);

  assert(valid, "Invalid signature");
  stateRoot = root;
}
