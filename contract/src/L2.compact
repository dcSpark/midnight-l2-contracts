pragma language_version >= 0.16 && <= 0.18;

import CompactStandardLibrary;
import "vendor/bricktowers/Crypto";

// exports from Crypto to enable off-chain pk derivation, signing, verification
export { derivePk, sign, Signature, verifySignature };

// public state
export ledger signers: Vector<3, CurvePoint>;
export ledger stateRoot: Bytes<32>;

constructor(newSigners: Vector<3, CurvePoint>, initialStateRoot: Bytes<32>) {
  signers = disclose(newSigners);
  stateRoot = disclose(initialStateRoot);
}

export circuit updateStateRoot(newRoot: Bytes<32>, sig: Signature): [] {
  verifySignature(newRoot, sig);

  const pk = disclose(sig).pk;
  const isAllowed: Boolean =
    (pk == signers[0]) ||
    (pk == signers[1]) ||
    (pk == signers[2]);

  assert(isAllowed, "unauthorized signer");

  stateRoot = disclose(newRoot);
}
