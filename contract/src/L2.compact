pragma language_version >= 0.16 && <= 0.18;

import CompactStandardLibrary;

// public state
export ledger signers: Vector<3, Bytes<32>>;
export ledger stateRoot: Bytes<32>;

constructor(newSigners: Vector<3, Bytes<32>>, initialStateRoot: Bytes<32>) {
  signers = disclose(newSigners);
  stateRoot = disclose(initialStateRoot);
}

// Mock verification; we wait for Midnight to ship verification primitives.
export circuit verifySignature(message: Bytes<32>, signature: Bytes<32>): Boolean {
  if (disclose(signature) == signers[0] || 
      disclose(signature) == signers[1] || 
      disclose(signature) == signers[2]) {
    return true;
  } else {
    return false;
  }
}

export circuit updateStateRoot(newRoot: Bytes<32>, signature: Bytes<32>): [] {
  assert(verifySignature(newRoot, signature), "Invalid signature");
  stateRoot = disclose(newRoot);
}
