// Claim fee vault coins in unshielded NIGHT (owner or sequencer)
export circuit claimL1FeesUnshielded(amount_: Uint<128>, recipient_: Bytes<32>): [] {
  L1_claimFeesUnshielded(disclose(amount_), disclose(recipient_));
}

// Batch lifecycle
export circuit commitBatch(parentBatchHash_: Bytes<32>, batchHash_: Bytes<32>): Uint<64> {
  return L1_commitBatch(disclose(parentBatchHash_), disclose(batchHash_));
}

export circuit finalizeBatch(
  batchPublicData_: L1_BatchPublicDataV1Full,
  signatures_: Vector<3, Signature>,
  signerBitmap_: Uint<8>,
  finalizeTimestamp_: Uint<64>
): [] {
  L1_finalizeBatch(
    disclose(batchPublicData_),
    signatures_,
    disclose(signerBitmap_),
    disclose(finalizeTimestamp_)
  );
}

// Admin
export circuit addSequencer(seq_: Bytes<32>): [] { L1_addSequencer(disclose(seq_)); }
export circuit removeSequencer(seq_: Bytes<32>): [] { L1_removeSequencer(disclose(seq_)); }
export circuit addFinalizer(f_: Bytes<32>): [] { L1_addFinalizer(disclose(f_)); }
export circuit removeFinalizer(f_: Bytes<32>): [] { L1_removeFinalizer(disclose(f_)); }
export circuit setVerifierSet(newSet_: Vector<3, NativePoint>): [] { L1_setVerifierSet(disclose(newSet_)); }

