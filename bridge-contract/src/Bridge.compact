// Claim a verified withdrawal in unshielded NIGHT
export circuit claimL1WithdrawalUnshielded(recipient_: Bytes<32>, amount_: Uint<128>): [] {
  L1_claimWithdrawalUnshielded(disclose(recipient_), disclose(amount_));
}

