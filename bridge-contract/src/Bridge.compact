// L1 deposit (unshielded NIGHT)
export circuit depositNIGHTUnshielded(
  amount_: Uint<128>,
  l2Recipient_: Bytes<32>,
  gasLimit_: Uint<64>,
  timestamp_: Uint<64>
): L1_DepositResult {
  return L1_depositNIGHTUnshielded(
    disclose(amount_),
    disclose(l2Recipient_),
    disclose(gasLimit_),
    disclose(timestamp_)
  );
}

// L1 deposit with unshielded fee
export circuit depositNIGHTUnshieldedWithFee(
  amount_: Uint<128>,
  fee_: Uint<128>,
  l2Recipient_: Bytes<32>,
  gasLimit_: Uint<64>,
  timestamp_: Uint<64>
): L1_DepositResult {
  return L1_depositNIGHTUnshieldedWithFee(
    disclose(amount_),
    disclose(fee_),
    disclose(l2Recipient_),
    disclose(gasLimit_),
    disclose(timestamp_)
  );
}

// L1 withdrawal proof relay
export circuit relayWithdrawNIGHTWithProof(
  l2Sender_: Bytes<32>,
  l1Recipient_: Bytes<32>,
  amount_: Uint<128>,
  proof_: L1_WithdrawProof16
): [] {
  L1_relayWithdrawNIGHTWithProof(
    disclose(l2Sender_),
    disclose(l1Recipient_),
    disclose(amount_),
    disclose(proof_)
  );
}

