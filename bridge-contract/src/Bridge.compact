// Bridge Contract (L1 + L2 Unified)
//
// Implements L1_CONTRACT_ARCHITECTURE.md for the L1 side.
// L2 modules remain for local simulation (withdraw message + merkle root building).

pragma language_version >= 0.20;

import CompactStandardLibrary;
import Signer;
import ProtocolTypes prefix PT_;
import L1Rollup prefix L1_;
import L2Gateway prefix GW_;
import L2Messenger prefix MSG_;
import L2MessageQueue prefix MQ_;

// ============================================================================
// RE-EXPORTS (for off-chain tooling convenience)
// ============================================================================

export { derivePk, Signature };

export pure circuit signBytes32(msg: Bytes<32>, sk: Field, nonce: Field): Signature {
  return sign<Bytes<32>>(msg, sk, nonce);
}

export pure circuit verifyBytes32(msg: Bytes<32>, signature: Signature): Boolean {
  return verifySignature<Bytes<32>>(msg, signature);
}

// Protocol helper wrappers
export pure circuit dsL2ToL1Withdraw(): Bytes<32> { return PT_dsL2ToL1Withdraw(); }
export pure circuit dsL2WithdrawLeaf(): Bytes<32> { return PT_dsL2WithdrawLeaf(); }
export pure circuit u64ToBytes32LE(x: Uint<64>): Bytes<32> { return PT_u64ToBytes32LE(x); }
export pure circuit u128ToBytes32LE(x: Uint<128>): Bytes<32> { return PT_u128ToBytes32LE(x); }
export pure circuit hashMerkleNode(left: Bytes<32>, right: Bytes<32>): Bytes<32> { return PT_hashMerkleNode(left, right); }

export pure circuit hashL2ToL1Withdraw(
  sender: Bytes<32>,
  recipient: Bytes<32>,
  amount: Uint<128>,
  nonce: Uint<64>
): Bytes<32> {
  return MSG_hashWithdrawMessage(sender, recipient, amount, nonce);
}

export pure circuit hashWithdrawLeaf(messageHash: Bytes<32>): Bytes<32> {
  return MSG_hashLeaf(messageHash);
}

// Ledger variables
export {
  L1_owner,
  L1_layer2ChainId,
  L1_rollupId,
  L1_verifierSet,
  L1_signatureThreshold,
  L1_sequencers,
  L1_finalizers,
  L1_committedBatches,
  L1_finalizedStateRoots,
  L1_withdrawRoots,
  L1_miscData,
  L1_firstCrossDomainMessageIndex,
  L1_nextCrossDomainMessageIndex,
  L1_nextUnfinalizedQueueIndex,
  L1_l1ToL2Deposits,
  L1_executedL2ToL1Messages,
  L1_lockedNIGHT,
  L1_feeVault,
  L1_messageRollingHashes,
  L1_pendingWithdrawals,
};

// ============================================================================
// CONSTRUCTOR
// ============================================================================

constructor(
  owner_: Bytes<32>,
  layer2ChainId_: Uint<64>,
  rollupId_: Bytes<32>,
  genesisStateRoot_: Bytes<32>,
  genesisBatchHash_: Bytes<32>,
  verifierSet_: Vector<3, NativePoint>,
  signatureThreshold_: Uint<8>,
  initialSequencer_: Bytes<32>,
  initialFinalizer_: Bytes<32>
) {
  L1_initialize(
    owner_,
    layer2ChainId_,
    rollupId_,
    genesisStateRoot_,
    genesisBatchHash_,
    verifierSet_,
    signatureThreshold_,
    initialSequencer_,
    initialFinalizer_
  );

  // L2 simulation modules
  GW_initialize();
  MSG_initialize();
  MQ_initialize();
}

// ============================================================================
// L2: WITHDRAWAL MESSAGE GENERATION (Gateway → Messenger → Queue)
// ============================================================================

export struct WithdrawNIGHTResult {
  nonce: Uint<64>;
  messageHash: Bytes<32>;
  leafHash: Bytes<32>;
}

export circuit withdrawNIGHT(recipient_: Bytes<32>, amount_: Uint<128>): WithdrawNIGHTResult {
  const recipient = disclose(recipient_);
  const amount = disclose(amount_);

  const senderPk = disclose(ownPublicKey());
  const senderBytes = senderPk.bytes;

  GW_debit(senderPk, amount);

  const nonce = MQ_getMessageCount();

  const hashes = MSG_computeWithdrawHashes(senderBytes, recipient, amount, nonce);

  const appendedIndex = MQ_appendLeaf(hashes.leafHash);
  assert(appendedIndex == nonce, "Queue index mismatch");

  return WithdrawNIGHTResult {
    nonce: nonce,
    messageHash: hashes.messageHash,
    leafHash: hashes.leafHash
  };
}

circuit getWithdrawRoot(): Bytes<32> { return MQ_getWithdrawRoot(); }
circuit getWithdrawMessageCount(): Uint<64> { return MQ_getMessageCount(); }

