pragma language_version >= 0.22;

module Signer {
  import CompactStandardLibrary;

  export struct Signature {
    pk: JubjubPoint;
    r: JubjubPoint;
    s: Field;
  }

  export struct Challenge<T> {
    r: JubjubPoint;
    pk: JubjubPoint;
    msg: T;
  }

  export pure circuit derivePk(sk: Field): JubjubPoint {
    return ecMulGenerator(sk);
  }

  export pure circuit computeChallenge<T>(r: JubjubPoint, pk: JubjubPoint, msg: T): Field {
    const c: Bytes<32> = persistentHash<Challenge<T>>(Challenge<T> {
      r: r,
      pk: pk,
      msg: msg
    });
    return degradeToTransient(c);
  }

  export pure circuit sign<T>(msg: T, sk: Field, nonce: Field): Signature {
    const pk = derivePk(sk);

    const r: JubjubPoint = ecMulGenerator(nonce);
    const c: Field = computeChallenge<T>(r, pk, msg);
    const s: Field = nonce + (c * sk);

    return Signature { pk: pk, r: r, s: s };
  }

  export pure circuit verifySignature<T>(msg: T, signature: Signature): Boolean {
    const {pk, r, s} = signature;
    const c: Field = computeChallenge<T>(r, pk, msg);

    const lhs: JubjubPoint = ecMulGenerator(s);
    const rhs: JubjubPoint = ecAdd(r, ecMul(pk, c));

    return lhs == rhs;
  }
}
