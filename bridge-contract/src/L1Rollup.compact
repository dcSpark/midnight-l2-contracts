  // L1→L2: deposit unshielded NIGHT and enqueue message (no fee)
  export circuit depositNIGHTUnshielded(
    amount_: Uint<128>,
    l2Recipient_: Bytes<32>,
    gasLimit_: Uint<64>,
    timestamp_: Uint<64>
  ): DepositResult {
    const amount = disclose(amount_);
    const l2Recipient = disclose(l2Recipient_);
    const gasLimit = disclose(gasLimit_);
    const ts = disclose(timestamp_);

    // TODO: all asserts should be ideally put back - we comment out
    // for now to avoid exceeding time-to-dismiss cost check
    //assertTimestampNotFuture(ts);
    //assert(amount > (0 as Uint<128>), "ZERO_AMOUNT");

    // TODO: there is a bug with receiveUnshielded currently
    // we eventually need to uncomment this to receive the token
    //receiveUnshielded(nativeToken(), amount);

    const queueIndex = nextCrossDomainMessageIndex;
    lockedNIGHT = ((lockedNIGHT + amount) as Uint<128>);

    const msg = PT_L1ToL2DepositMessage {
      sender: callerId(),
      recipient: l2Recipient,
      amount: amount,
      nonce: queueIndex,
      gasLimit: gasLimit,
      dataHash: zero32()
    };

    const messageHash = PT_hashL1ToL2Deposit(msg);
    const [idx, rollingHash] = appendCrossDomainMessage(messageHash, ts);
    assert(idx == queueIndex, "QUEUE_INDEX_MISMATCH");

    l1ToL2Deposits.insert(queueIndex, msg);

    return DepositResult { queueIndex: queueIndex, messageHash: messageHash, rollingHash: rollingHash };
  }

  // L1→L2: deposit unshielded NIGHT + unshielded fee
  export circuit depositNIGHTUnshieldedWithFee(
    amount_: Uint<128>,
    fee_: Uint<128>,
    l2Recipient_: Bytes<32>,
    gasLimit_: Uint<64>,
    timestamp_: Uint<64>
  ): DepositResult {
    const amount = disclose(amount_);
    const fee = disclose(fee_);
    const l2Recipient = disclose(l2Recipient_);
    const gasLimit = disclose(gasLimit_);
    const ts = disclose(timestamp_);

    assertTimestampNotFuture(ts);
    assert(amount > (0 as Uint<128>), "ZERO_AMOUNT");
    assert(fee > (0 as Uint<128>), "FEE_MUST_BE_NONZERO");

    receiveUnshielded(nativeToken(), amount);
    receiveUnshielded(nativeToken(), fee);

    const queueIndex = nextCrossDomainMessageIndex;

    lockedNIGHT = ((lockedNIGHT + amount) as Uint<128>);
    feeVault = ((feeVault + fee) as Uint<128>);

    const msg = PT_L1ToL2DepositMessage {
      sender: callerId(),
      recipient: l2Recipient,
      amount: amount,
      nonce: queueIndex,
      gasLimit: gasLimit,
      dataHash: zero32()
    };

    const messageHash = PT_hashL1ToL2Deposit(msg);
    const [idx, rollingHash] = appendCrossDomainMessage(messageHash, ts);
    assert(idx == queueIndex, "QUEUE_INDEX_MISMATCH");

    l1ToL2Deposits.insert(queueIndex, msg);

    return DepositResult { queueIndex: queueIndex, messageHash: messageHash, rollingHash: rollingHash };
  }

  // Record a pending withdrawal (called after proof verification)
  circuit recordPendingWithdrawal(recipient: Bytes<32>, amount: Uint<128>): [] {
    assert(amount > (0 as Uint<128>), "ZERO_AMOUNT");
    assert(lockedNIGHT >= amount, "INSUFFICIENT_LOCKED_LIQUIDITY");
    lockedNIGHT = ((lockedNIGHT - amount) as Uint<128>);

    if (pendingWithdrawals.member(recipient)) {
      const existing = pendingWithdrawals.lookup(recipient);
      pendingWithdrawals.insert(recipient, ((existing + amount) as Uint<128>));
    } else {
      pendingWithdrawals.insert(recipient, amount);
    }
  }

