// L1Rollup Module
//
// Implements L1_CONTRACT_ARCHITECTURE.md layers inside one Compact contract:
// - Layer 1 (Gateway): deposit NIGHT custody + payout on withdrawal finalization
// - Layer 2 (Messenger): replay protection + withdrawal proof verification + fee vault
// - Layer 3 (MessageQueue): rolling hash chain + timestamps + finalization pointer
// - Layer 4 (RollupChain): commitBatch + finalizeBatch with threshold signatures
//
// FIXES / IMPROVEMENTS:
// - Remove brittle assertNow(); only require timestamps are not in the future.
// - Fix withdrawal claim deadlock: allow partial spends + reinsert change coin.
// - Implement fee collection via optional fee coin + claimFees().
// - Remove l1DepositCounter: key liquidity/fee coins by queueIndex (stable unique ID).
// - Keep code lean: avoid new counters, reuse queueIndex as the only ID.

pragma language_version >= 0.20;

module L1Rollup {

  import CompactStandardLibrary;
  import ProtocolTypes prefix PT_;
  import Signer;

  export { Signature };

  // ============================================================================
  // TYPES
  // ============================================================================

  export struct RollupMiscData {
    lastCommittedBatchIndex: Uint<64>;
    lastFinalizedBatchIndex: Uint<64>;
    lastFinalizeTimestamp: Uint<64>;
    flags: Uint<8>;
    reserved: Uint<88>;
  }

  export struct BatchPublicDataV1Full {
    version: Uint<32>;
    layer2ChainId: Uint<64>;
    rollupId: Bytes<32>;
    batchIndex: Uint<64>;

    daStartHeight: Uint<64>;
    daEndHeight: Uint<64>;
    daCommitment: Bytes<32>;

    lastProcessedQueueIndex: Uint<64>;
    messageQueueHash: Bytes<32>;

    prevStateRoot: Bytes<32>;
    prevBatchHash: Bytes<32>;
    postStateRoot: Bytes<32>;
    batchHash: Bytes<32>;

    withdrawRoot: Bytes<32>;
  }

  export struct DepositResult {
    queueIndex: Uint<64>;
    messageHash: Bytes<32>;
    rollingHash: Bytes<32>;
  }

  export struct WithdrawProof16 {
    batchIndex: Uint<64>;
    nonce: Uint<64>;
    indexBits: Vector<16, Boolean>;
    siblings: Vector<16, Bytes<32>>;
  }

  // ============================================================================
  // LEDGER STATE
  // ============================================================================

  // Immutable config
  export sealed ledger owner: Bytes<32>;
  export sealed ledger layer2ChainId: Uint<64>;
  export sealed ledger rollupId: Bytes<32>;

  // Verifier set (oracle committee) + threshold
  export ledger verifierSet: Vector<3, NativePoint>;
  export sealed ledger signatureThreshold: Uint<8>;

  // Access control
  export ledger sequencers: Set<Bytes<32>>;
  export ledger finalizers: Set<Bytes<32>>; // empty => permissionless finalizeBatch

  // Rollup core maps
  export ledger committedBatches: Map<Uint<64>, Bytes<32>>;
  export ledger finalizedStateRoots: Map<Uint<64>, Bytes<32>>;
  export ledger withdrawRoots: Map<Uint<64>, Bytes<32>>;
  export ledger miscData: RollupMiscData;

  // L1 Message Queue
  export ledger firstCrossDomainMessageIndex: Uint<64>;
  export ledger nextCrossDomainMessageIndex: Uint<64>;
  export ledger nextUnfinalizedQueueIndex: Uint<64>;
  export ledger messageRollingHashes: Map<Uint<64>, Bytes<32>>;
  ledger messageTimestamps: Map<Uint<64>, Uint<64>>;

  // Deposit preimages (Compact has no logs)
  export ledger l1ToL2Deposits: Map<Uint<64>, PT_L1ToL2DepositMessage>;

  // Messenger replay-protection for L2→L1
  export ledger executedL2ToL1Messages: Set<Bytes<32>>;

  // NIGHT accounting
  // NOTE: lockedNIGHT is "available liquidity not yet reserved for pending withdrawals".
  export ledger lockedNIGHT: Uint<128>;

  // Fee accounting (native token)
  export ledger feeVault: Uint<128>;

  // Liquidity coins backing withdrawals (keyed by L1→L2 queueIndex)
  // NOTE: Shielded flow disabled for unshielded-only pipeline.
  // ledger liquidityCoins: Map<Uint<64>, QualifiedShieldedCoinInfo>;

  // Fee coins backing L2 gas fees (keyed by L1→L2 queueIndex)
  // NOTE: Shielded flow disabled for unshielded-only pipeline.
  // ledger feeCoins: Map<Uint<64>, QualifiedShieldedCoinInfo>;

  // Pending withdrawals (recipient -> amount)
  export ledger pendingWithdrawals: Map<Bytes<32>, Uint<128>>;

  // ============================================================================
  // WITNESSES
  // ============================================================================

  witness signerBitmapBits(bitmap: Uint<8>): Vector<3, Boolean>;

  // ============================================================================
  // HELPERS
  // ============================================================================

  export pure circuit zero32(): Bytes<32> { return pad(32, ""); }

  export circuit callerId(): Bytes<32> { return disclose(ownPublicKey()).bytes; }

  circuit onlyOwner(): [] { assert(callerId() == owner, "UNAUTHORIZED"); }

  circuit onlySequencer(): [] { assert(sequencers.member(callerId()), "NOT_SEQUENCER"); }

  circuit onlyFinalizerIfEnabled(): [] {
    if (!finalizers.isEmpty()) {
      assert(finalizers.member(callerId()), "NOT_FINALIZER");
    }
  }

  circuit onlyOwnerOrSequencer(): [] {
    const c = callerId();
    assert(c == owner || sequencers.member(c), "NOT_AUTHORIZED");
  }

  // Timestamp policy:
  // We cannot read exact block time, so we only enforce "not in the future".
  circuit assertTimestampNotFuture(ts: Uint<64>): [] {
    assert(blockTimeGte(ts), "BAD_TIMESTAMP_FUTURE");
  }

  // Verify a 3-bit bitmap equals provided bits (no bitwise ops)
  export pure circuit verifyBitmap3(bits: Vector<3, Boolean>, bitmap: Uint<8>): Boolean {
    const sum: Field =
      (bits[0] as Field) * (1 as Field) +
      (bits[1] as Field) * (2 as Field) +
      (bits[2] as Field) * (4 as Field);
    return sum == (bitmap as Field);
  }

  export pure circuit countBits3(bits: Vector<3, Boolean>): Uint<8> {
    const c: Field = (bits[0] as Field) + (bits[1] as Field) + (bits[2] as Field);
    return (c as Uint<8>);
  }

  export circuit verifyThresholdSignatures(
    digest: Bytes<32>,
    signatures_: Vector<3, Signature>,
    signerBitmap: Uint<8>
  ): [] {
    const signatures = disclose(signatures_);
    const bits = disclose(signerBitmapBits(signerBitmap));
    assert(verifyBitmap3(bits, signerBitmap), "BAD_SIGNER_BITMAP");

    if (bits[0]) {
      assert(verifySignature<Bytes<32>>(digest, signatures[0]), "BAD_SIG_0");
      assert(disclose(signatures[0]).pk == verifierSet[0], "WRONG_SIGNER_0");
    }
    if (bits[1]) {
      assert(verifySignature<Bytes<32>>(digest, signatures[1]), "BAD_SIG_1");
      assert(disclose(signatures[1]).pk == verifierSet[1], "WRONG_SIGNER_1");
    }
    if (bits[2]) {
      assert(verifySignature<Bytes<32>>(digest, signatures[2]), "BAD_SIG_2");
      assert(disclose(signatures[2]).pk == verifierSet[2], "WRONG_SIGNER_2");
    }

    const count = countBits3(bits);
    assert(count >= signatureThreshold, "INSUFFICIENT_SIGNATURES");
  }

  // Empty depth-16 Merkle root where all leaves are 0x00..00.
  // Compacted using fold: z0 = H(0,0), then apply H(z,z) 15 times => z15.
  export pure circuit emptyWithdrawRoot16(): Bytes<32> {
    const z0 = PT_hashMerkleNode(zero32(), zero32());
    const steps = default<Vector<15, Boolean>>;
    return fold((acc, _) => PT_hashMerkleNode(acc, acc), z0, steps);
  }

  // ============================================================================
  // L1 MESSAGE QUEUE (Layer 3)
  // ============================================================================

  circuit getRollingHashOrZero(index: Uint<64>): Bytes<32> {
    return messageRollingHashes.member(index) ? messageRollingHashes.lookup(index) : zero32();
  }

  export circuit appendCrossDomainMessage(leafHash: Bytes<32>, timestamp: Uint<64>): [Uint<64>, Bytes<32>] {
    const index = nextCrossDomainMessageIndex;
    const prev = getRollingHashOrZero(((index - (1 as Uint<64>)) as Uint<64>));
    const rolling = PT_hashRollingStep(prev, leafHash);

    messageRollingHashes.insert(index, rolling);
    messageTimestamps.insert(index, timestamp);
    nextCrossDomainMessageIndex = ((nextCrossDomainMessageIndex + (1 as Uint<64>)) as Uint<64>);

    return [index, rolling];
  }

  export circuit finalizePoppedCrossDomainMessage(newIndex: Uint<64>): [] {
    assert(newIndex >= nextUnfinalizedQueueIndex, "QUEUE_POINTER_REGRESSION");
    nextUnfinalizedQueueIndex = newIndex;
  }

