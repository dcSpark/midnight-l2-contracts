  // Claim a pending withdrawal by sending unshielded NIGHT to the recipient address.
  export circuit claimWithdrawalUnshielded(recipient_: Bytes<32>, amount_: Uint<128>): [] {
    const recipient = disclose(recipient_);
    const amount = disclose(amount_);

    assert(amount > (0 as Uint<128>), "ZERO_AMOUNT");
    assert(pendingWithdrawals.member(recipient), "NO_PENDING_WITHDRAWAL");

    const pending = pendingWithdrawals.lookup(recipient);
    assert(amount <= pending, "CLAIM_EXCEEDS_PENDING");

    const remaining = ((pending - amount) as Uint<128>);
    if (remaining == (0 as Uint<128>)) {
      pendingWithdrawals.remove(recipient);
    } else {
      pendingWithdrawals.insert(recipient, remaining);
    }

    const user = UserAddress { bytes: recipient };
    // TODO: uncomment on ledger-v8 where this is hopefully fixed again
    // sendUnshielded(nativeToken(), amount, right<ContractAddress, UserAddress>(user));
  }

