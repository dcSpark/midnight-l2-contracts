  // Claim fees (sequencer or owner) as unshielded NIGHT.
  export circuit claimFeesUnshielded(amount_: Uint<128>, recipient_: Bytes<32>): [] {
    onlyOwnerOrSequencer();

    const amount = disclose(amount_);
    const recipient = disclose(recipient_);

    assert(amount > (0 as Uint<128>), "ZERO_AMOUNT");
    assert(amount <= feeVault, "CLAIM_EXCEEDS_FEE_VAULT");

    feeVault = ((feeVault - amount) as Uint<128>);

    const user = UserAddress { bytes: recipient };
    sendUnshielded(nativeToken(), amount, right<ContractAddress, UserAddress>(user));
  }

  circuit getPendingWithdrawal(recipient: Bytes<32>): Uint<128> {
    return pendingWithdrawals.member(recipient) ? pendingWithdrawals.lookup(recipient) : (0 as Uint<128>);
  }

