{
  "name": "@meshsdk/bridge-cli",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": "./dist/cli.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "test-undeployed": "vitest --no-file-parallelism run",
    "test-preview": "RUN_ENV_TESTS=true TEST_ENV=preview vitest run",
    "tui-undeployed": "npx --yes tsx --tsconfig tsconfig.json src/tui_standalone.ts",
    "tui-preview": "npx --yes tsx --tsconfig tsconfig.json src/tui_preview.ts",
    "setup-undeployed": "npx --yes tsx --tsconfig tsconfig.json src/setup/standalone.ts",
    "deploy-undeployed": "npx --yes tsx --tsconfig tsconfig.json src/cli.ts deploy -n undeployed",
    "executor": "npx --yes tsx --tsconfig tsconfig.json src/executor-server.ts",
    "ps-undeployed": "docker compose -f ps-undeployed.yml up",
    "ps-preview": "docker compose -f ps-preview.yml up",
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "bech32": "^2.0.0",
    "bridge-contract": "*",
    "commander": "^14.0.3",
    "@midnight-ntwrk/ledger-v7": "7.0.0",
    "@midnight-ntwrk/compact-runtime": "0.14.0"
  }
}